# Don't put any keys in code. See https://docs.stripe.com/keys-best-practices.
# Copy to .env and fill in real values from https://dashboard.stripe.com/test/apikeys

# Server-only (never prefix with VITE_)
STRIPE_SECRET_KEY=sk_test_...
DOMAIN=http://localhost:5173/the-baybayin-project
PORT=4243

# Stripe Price IDs per product (Dashboard → Products → Price ID)
STRIPE_PRICE_PROCLAMATIONS_DESERET=price_...
STRIPE_PRICE_PROCLAMATIONS_AUREBESH_CANON=price_...
STRIPE_PRICE_PROCLAMATIONS_AUREBESH_LEGENDS=price_...
STRIPE_PRICE_PROCLAMATIONS_BAYBAYIN=price_...

# Browser-accessible (Vite requires VITE_ prefix)
# Leave empty to keep mailto fallback. Set to enable Stripe Checkout from the shop.
VITE_CHECKOUT_API_URL=http://localhost:4243/api/create-checkout-session
